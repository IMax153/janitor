use flake

# Deploy-time secrets. Alchemy reads them during Worker init and uploads
# them as Cloudflare secret bindings; they never live in the repo.
dotenv_if_exists

# Rootless podman for the testcontainers-backed Postgres suites.
export DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
export TESTCONTAINERS_RYUK_DISABLED=true
